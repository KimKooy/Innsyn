generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  entraOid    String   @unique @map("entra_oid")
  email       String
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  lastLoginAt DateTime @default(now()) @map("last_login_at")

  assets Asset[]

  @@map("users")
}

model Asset {
  id          String    @id @default(uuid()) @db.Uuid
  // sceneId references the scene short-id from the frontend scenes registry.
  // We intentionally don't FK to a Scene table yet — Scene management will
  // move to the DB later; for M4 the loose coupling lets us iterate.
  sceneId     String    @map("scene_id")
  title       String
  description String?
  fileName    String    @map("file_name")
  contentType String    @map("content_type")
  // BigInt now to avoid a future migration if MAX_FILE_BYTES ever exceeds
  // the 2.1 GB Int32 ceiling. DTOs convert to Number at the boundary.
  sizeBytes   BigInt    @map("size_bytes")
  // blobPath is the relative path within AZURE_STORAGE_CONTAINER.
  blobPath    String    @map("blob_path")
  // Position in the scene's spatial reference. The SR is determined by the
  // scene config; we don't store it on the asset row.
  x           Float
  y           Float
  z           Float
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  // createdAt: when the DB row was created (POST /api/assets).
  // uploadedAt: when the client confirmed the blob upload finished
  //   (POST /api/assets/:id/finalize). Null = orphaned row, hidden from
  //   list/download. A future sweep job can GC orphans older than N hours.
  createdAt   DateTime  @default(now()) @map("created_at")
  uploadedAt  DateTime? @map("uploaded_at")
  deletedAt   DateTime? @map("deleted_at")

  uploader User @relation(fields: [uploadedBy], references: [id])

  @@index([sceneId])
  @@index([deletedAt])
  @@map("assets")
}
