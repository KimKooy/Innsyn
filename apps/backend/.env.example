# Database — kobler til lokal Docker Compose Postgres
DATABASE_URL="postgresql://innsyn:innsyn@localhost:5432/innsyn?schema=public"

# HTTP-server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Frontend-opphav for CORS (lokal Vite)
CORS_ORIGIN=http://localhost:5173

# Entra ID — fra IT (gjelder app-registrering `innsyn-dev`).
# Inntil disse er satt returnerer GET /api/me 503.
AUTH_TENANT_ID=
AUTH_AUDIENCE=

# Azure Blob Storage — for asset-opplasting.
# Lokal utvikling: bruk Azurite-emulator (https://learn.microsoft.com/azure/storage/common/storage-use-azurite)
#   AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
#   AZURE_STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
#   AZURE_STORAGE_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
# Produksjon: managed identity (TODO M9)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=innsyn-assets
