# Database — kobler til lokal Docker Compose Postgres
DATABASE_URL="postgresql://innsyn:innsyn@localhost:5432/innsyn?schema=public"

# HTTP-server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Frontend-opphav for CORS (lokal Vite)
CORS_ORIGIN=http://localhost:5173

# Entra ID — fra IT (gjelder app-registrering `innsyn-dev`).
# Inntil disse er satt returnerer GET /api/me 503.
AUTH_TENANT_ID=
AUTH_AUDIENCE=
