# Backend (samme maskin under utvikling — proxy går via Vite)
VITE_API_BASE_URL=

# AGOL — én av disse styrer hva som lastes ved oppstart.
#
# 1) ITEM_ID: AGOL Web Scene item-ID (32-tegns hex). Bruker
#    <arcgis-scene item-id="..."> direkte. Trenger token bare hvis
#    scenen ikke er delt med «Everyone».
# 2) SCENE_SERVICE_URL: direkte Scene Service-URL for IntegratedMesh-lag.
#    Vi bygger en tom WebScene og legger til laget programmatisk.
#    For å rendre uten token må selve service'en være offentlig.
VITE_AGOL_ITEM_ID=
VITE_AGOL_SCENE_SERVICE_URL=

# Entra ID — fra IT (gjelder app-registrering `innsyn-dev`).
# Inntil disse er satt vises «Ikke pålogget» i toppbaren.
VITE_AUTH_TENANT_ID=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_API_SCOPE=
